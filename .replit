run = "npm run dev"
entrypoint = "package.json"
hidden = [".config", ".next", "node_modules"]
modules = ["nodejs-22", "python3"]
onBoot = "node scripts/install-hwp-python-deps.mjs"

[nix]
channel = "stable-24_11"
packages = ["python312", "python312Packages.pip"]

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
